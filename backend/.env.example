# FleetOS Pulse Backend Environment Configuration Example
PROJECT_NAME="FleetOS Pulse API"
API_V1_STR="/api"

# Application Environment (development, demo, production)
ENVIRONMENT=development
PORT=8000

# Administrative API Key for protecting demo reset/scenario endpoints in production
ADMIN_API_KEY=change_this_to_a_secure_admin_key_in_prod

# Database URL (Defaults to local SQLite with absolute pathing. Set PostgreSQL URL for production)
DATABASE_URL="sqlite:///./fleetos_pulse.db"
# Example PostgreSQL URL for Render/Railway:
# DATABASE_URL="postgresql://user:password@host:5432/fleetos_db"

# Allowed CORS Origins (comma-separated or JSON array)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Guardrail & Rule Parameters
STALE_THRESHOLD_MINUTES=30
MIN_FARE_MULTIPLIER=0.75
MAX_FARE_MULTIPLIER=1.35
MAX_STEP_CHANGE_PERCENT=15.0
